POSTGRES_DB=playersignal
POSTGRES_USER=playersignal
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
STEAM_MAX_PAGES=10
STEAM_PAGE_DELAY_MS=500

# AI is opt-in. Keep the key server-side; never commit .env.
ANALYSIS_PROVIDER=local
OPENAI_API_KEY=
ANALYSIS_MODEL=local-rules-v1
ALLOW_PAID_AI=false
# For an installed local model: ANALYSIS_PROVIDER=ollama and ANALYSIS_MODEL=<local model name>
OLLAMA_URL=http://host.docker.internal:11434
ANALYSIS_MAX_REVIEWS=25

# Optional isolated accounts. Requires HTTPS and secure cookies for remote deployment.
AUTH_ENABLED=false
AUTH_COOKIE_SECURE=false
POSTGRES_VOLUME=playersignal_postgres_data
POSTGRES_VOLUME_EXTERNAL=false

# Durable workspace quotas; every provider retry counts. Zero disables all new analysis attempts, including local rules.
ANALYSIS_MONTHLY_ATTEMPTS=500
SYNC_HOURLY_LIMIT=12

# Dispatcher alone starts no work: each game schedule is disabled until enabled in Processing.
SCHEDULER_ENABLED=true
